// Zed settings
{
  "session": {
    "trust_all_worktrees": true,
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
    "anthropic_retention": false,
  },
  "lsp": {
    "vtsls": {
      "settings": {
        "typescript": {
          "updateImportsOnFileMove": {
            "enabled": "always",
          },
        },
        "javascript": {
          "updateImportsOnFileMove": {
            "enabled": "always",
          },
        },
      },
      "enable_lsp_tasks": true,
    },
  },
  "cli_default_open_behavior": "existing_window",

  "agent_servers": {
    "claude-acp": {
      "default_config_options": {
        "effort": "xhigh",
        "mode": "plan",
      },
      "type": "registry",
    },
    "codex-acp": {
      "default_config_options": {
        "mode": "agent-full-access",
        "reasoning_effort": "xhigh",
      },
      "type": "registry",
    },
  },

  "base_keymap": "VSCode",
  "vim_mode": false,

  "theme": {
    "mode": "light", //dark,light,
    "light": "Tokyo Night Storm",
    "dark": "Nordfox - blurred",
  },
  "theme_overrides": {
    "Kanagawa": {
      "tab.active_background": "#76946A80",
    },
    "Nordfox - blurred": {
      "tab.active_background": "#76946A80",
    },
  },
  "icon_theme": {
    "mode": "light",
    "light": "Material Icon Theme",
    "dark": "Material Icon Theme",
  },

  "tabs": {
    "file_icons": true,
    "git_status": true,
    "show_close_button": "always",
    "show_diagnostics": "all",
  },

  "current_line_highlight": "all",
  "soft_wrap": "editor_width",
  "scrollbar": {
    "show": "never",
    "axes": {
      "vertical": true,
      "horizontal": true,
    },
    "diagnostics": "all",
    "search_results": true,
    "selected_text": true,
    "selected_symbol": true,
  },

  "minimap": {
    "show": "never",
    "thumb": "always",
    "thumb_border": "full",
  },

  "project_panel": {
    "dock": "right",
    "auto_fold_dirs": false,
    "indent_size": 8,
    "indent_guides": {
      "show": "always",
    },
    "sort_mode": "directories_first",
    "file_icons": true,
    "folder_icons": true,
    "git_status": true,
    "entry_spacing": "comfortable",
  },

  "preview_tabs": {
    "enabled": false,
  },

  "status_bar": {
    "experimental.show": true,
  },

  "colorize_brackets": true,
  "code_lens": "on",

  "diagnostics": {
    "inline": {
      "enabled": true,
      "update_debounce_ms": 150,
      "padding": 4,
      "min_column": 80,
      "max_severity": "warning",
    },
  },

  "show_whitespaces": "boundary",

  "indent_guides": {
    "enabled": true,
    "line_width": 1,
    "active_line_width": 1,
    "coloring": "indent_aware",
  },

  "ui_font_size": 14,
  "buffer_font_size": 14,
  "agent_buffer_font_size": 14,
}
