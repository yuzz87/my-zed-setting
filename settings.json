// Zed settings
{
  "cli_default_open_behavior": "existing_window",

  "agent_servers": {
    "claude-acp": {
      "type": "registry",
    },
    "codex-acp": {
      "default_config_options": {
        "reasoning_effort": "xhigh",
      },
      "type": "registry",
    },
  },

  "base_keymap": "VSCode",

  "theme": {
    "mode": "dark",
    "light": "Gruvbox Light",
    "dark": "Kanagawa",
  },

  "icon_theme": {
    "mode": "dark",
    "light": "Zed (Default)",
    "dark": "Material Icon Theme",
  },
  "minimap": {
    "show": "always",
    "thumb": "always",
    "thumb_border": "full",
  },

  "project_panel": {
    "dock": "right",
    "auto_fold_dirs": false,
    "indent_size": 26,
    "indent_guides": {
      "show": "always",
    },
    "sort_mode": "directories_first",
    "file_icons": true,
    "folder_icons": true,
    "git_status": true,
    "entry_spacing": "comfortable",
  },

  "preview_tabs": {
    "enabled": false,
  },

  "status_bar": {
    "experimental.show": false,
  },

  "colorize_brackets": true,

  "show_whitespaces": "boundary",

  "indent_guides": {
    "enabled": true,
    "line_width": 1,
    "active_line_width": 1,
    "coloring": "indent_aware",
  },

  "ui_font_size": 20,
  "buffer_font_size": 15,
}
